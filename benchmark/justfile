# Harness benchmark: aikido vs aikido+bash vs opencode (coding suite) and
# claude-code vs opencode vs aikido-worker (worker suite). See README.md.
# Needs OPENROUTER_API_KEY (or CLAUDE_OPENROUTER_API_KEY), go, bash, jq, opencode; the worker suite also git, perl, claude.

models := "anthropic/claude-haiku-5.5,z-ai/glm-5.3"

default: validate

# Prove every checker of both suites: fails on the untouched fixture, passes on solve.sh. No LLM calls.
validate:
    go run ./cmd/bench -validate
    go run ./cmd/bench -suite worker -validate

# Worker suite: 1 incident x claude-code and opencode x haiku x 1 rep, about $0.03.
smoke-worker:
    go run ./cmd/bench -suite worker -harness claude-code,opencode -task incident-crashloop -run-id smoke-worker-$(date +%Y%m%d-%H%M%S)

# Worker suite matrix: 4 tasks x claude-code, opencode, aikido-worker x haiku x reps (default 3 = 36 runs).
# aikido-worker is skipped with a message until `aikido agent` has --direct/--shell/--allow/--env/--system-file.
bench-worker reps="3" *args:
    go run ./cmd/bench -suite worker -reps {{reps}} -run-id worker-$(date +%Y%m%d-%H%M%S) {{args}}

# 2 tasks x 3 harnesses x 1 model x 1 rep, a few cents.
smoke:
    go run ./cmd/bench -task fix-bug,count-lines -run-id smoke-$(date +%Y%m%d-%H%M%S)

# Full matrix: 12 tasks x 3 harnesses x 2 models x reps (default 3 = 216 runs). Extra flags pass through.
bench reps="3" *args:
    go run ./cmd/bench -model {{models}} -reps {{reps}} -run-id full-$(date +%Y%m%d-%H%M%S) {{args}}

# Re-render summary.md of a results directory.
summarize dir:
    go run ./cmd/bench -summarize {{dir}}

# Lint with the repo's govengers baseline; this module has no config of its own.
lint:
    golangci-lint run --config ../.golangci.yml ./...

check: lint
    go vet ./...
    go test ./...
